# Environment Variable Template
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env

# PostgreSQL Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=ticket_db

# Full connection URL
DATABASE_URL=postgresql://admin:your_strong_password_here@db:5432/ticket_db

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Webhook Notifications (Optional - add real Discord/Slack URL to enable)
DISCORD_WEBHOOK_URL=

# Admin Panel Password
ADMIN_PASSWORD=change_me_before_production

# ─── AI Classification ────────────────────────────────────────────────────────
# Provider seç: gemini | huggingface | transformers | ollama | none
AI_PROVIDER=gemini

# Google Gemini — ücretsiz key: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# HuggingFace — ücretsiz token: https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_your_token_here

# Ollama — yerel kurulum için: https://ollama.com
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# AI güven eşiği (0.0–1.0) — altında kalırsa RegEx motoruna düşer
AI_CONFIDENCE_THRESHOLD=0.65
